{
  "name": "@mrbprakash06/bs",
  "version": "1.0.1",
  "description": "Bikram Sambat (BS) date utility for JavaScript/TypeScript",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp table.json dist/table.json",
    "test": "rm -rf dist && vitest run",
    "prepublishOnly": "pnpm test && pnpm build",
    "pack:check": "pnpm build && npm_config_cache=/tmp/npm-cache npm pack --dry-run"
  },
  "keywords": [
    "bikram-sambat",
    "bs",
    "nepali-date",
    "date-converter"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrbprakash06/bs.git"
  },
  "bugs": {
    "url": "https://github.com/mrbprakash06/bs/issues"
  },
  "homepage": "https://github.com/mrbprakash06/bs#readme",
  "packageManager": "pnpm@10.22.0",
  "devDependencies": {
    "@types/node": "^25.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
